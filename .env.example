# Copy to .env.local and fill in. Never commit real values.

# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Payments: provider-independent. "mock" is only allowed outside production.
PAYMENT_PROVIDER=mock
PAYMENTS_MOCK_ENABLED=true

# Local SQL tests (npm run test:db)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Scheduled jobs (/api/cron, hourly) — random string, also used by Vercel Cron
CRON_SECRET=

# Optional notification channels (enabled automatically when set)
RESEND_API_KEY=
EMAIL_FROM="KADR TOP UZ <noreply@kadrtop.uz>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
